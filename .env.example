NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_APP_URL=https://foodvansnear.me

# Mapbox public key (starts with pk.) - map tiles and suburb/postcode search.
# Without it the map falls back to OpenStreetMap and suburb search is off.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe (Food Vans Near Me account). Secret key goes in Vercel only - never commit it.
# Without it, sign-up buttons fall back to emailing hello@.
STRIPE_SECRET_KEY=
# Stripe's no-code customer portal login link (Settings > Billing > Customer portal)
NEXT_PUBLIC_STRIPE_PORTAL_URL=
